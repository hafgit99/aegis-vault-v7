{
  "name": "aegis-vault-v7",
  "private": true,
  "version": "7.0.2.0",
  "type": "module",
  "bin": {
    "aegis-cli": "./scripts/aegis-cli.cjs"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/generate-asset-integrity-manifest.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','coverage','server.js']) fs.rmSync(p,{recursive:true,force:true});\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/**/*.cjs\"",
    "i18n:audit": "node scripts/i18n-audit.cjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:run": "tauri android run",
    "android:clean:jni": "node scripts/clean-android-jni.cjs",
    "android:build": "tauri android build",
    "android:build:apk": "tauri android build --apk",
    "android:build:apk:debug": "tauri android build --apk --debug",
    "android:build:apk:debug:aarch64": "npm run android:clean:jni && tauri android build --apk --debug --target aarch64",
    "android:build:apk:aarch64": "node scripts/android-build-release.cjs",
    "android:release:gate": "node scripts/android-release-gate.cjs",
    "android:release:evidence": "node scripts/android-release-evidence.cjs",
    "android:release:evidence:verify": "node scripts/android-release-evidence-verify.cjs",
    "android:release:evidence:summary": "node scripts/android-release-evidence-summary.cjs",
    "android:release:notes": "node scripts/android-release-notes.cjs",
    "android:release:version:check": "node scripts/android-version-check.cjs",
    "android:release:signing:check": "node scripts/android-signing-check.cjs",
    "android:release:signing:init": "node scripts/android-signing-init.cjs",
    "android:release:report": "node scripts/android-release-report.cjs",
    "android:device:doctor": "node scripts/android-device-doctor.cjs",
    "android:device:install": "node scripts/android-device-smoke.cjs install",
    "android:device:launch": "node scripts/android-device-smoke.cjs launch",
    "android:device:status": "node scripts/android-device-smoke.cjs status",
    "android:device:smoke": "node scripts/android-device-smoke.cjs smoke",
    "android:device:security": "node scripts/android-device-security.cjs",
    "ios:readiness": "node scripts/ios-readiness-check.cjs",
    "ios:readiness:strict": "node scripts/ios-readiness-check.cjs --strict",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "release:local": "node scripts/local-release.cjs",
    "release:local:skip-tests": "node scripts/local-release.cjs --skip-tests",
    "release:macos:universal": "node scripts/local-release.cjs --mac-universal",
    "release:checksums": "node scripts/generate-checksums.cjs",
    "release:collect": "node scripts/collect-release-artifacts.cjs",
    "build:extension": "node scripts/build-extension.js",
    "build:extension:debug": "node scripts/build-extension.js --debug",
    "package:chrome:zip": "node scripts/chrome-zip.cjs",
    "extension:safari": "node scripts/safari-extension.cjs",
    "package:firefox:xpi": "node scripts/firefox-xpi.cjs",
    "sign:firefox:xpi": "node scripts/firefox-xpi.cjs --sign",
    "cli": "node scripts/aegis-cli.cjs",
    "register:extension": "node scripts/register-host.js",
    "test:mutation": "stryker run stryker.conf.mjs",
    "test:mutation:dry": "stryker run stryker.conf.mjs --dryRunOnly",
    "test:mutation:importer": "stryker run stryker.importer.conf.mjs",
    "test:mutation:importer:dry": "stryker run stryker.importer.conf.mjs --dryRunOnly",
    "test:mutation:storage": "stryker run stryker.storage.conf.mjs",
    "test:mutation:storage:dry": "stryker run stryker.storage.conf.mjs --dryRunOnly",
    "test:mutation:storage:orchestration": "stryker run stryker.storage-orchestration.conf.mjs",
    "test:mutation:storage:orchestration:dry": "stryker run stryker.storage-orchestration.conf.mjs --dryRunOnly",
    "test:mutation:importer:helpers": "stryker run stryker.importer-helpers.conf.mjs",
    "test:mutation:importer:helpers:dry": "stryker run stryker.importer-helpers.conf.mjs --dryRunOnly",
    "test:mutation:security": "stryker run stryker.security.conf.mjs",
    "test:mutation:security:dry": "stryker run stryker.security.conf.mjs --dryRunOnly",
    "test:mutation:search": "stryker run stryker.search.conf.mjs",
    "test:mutation:search:dry": "stryker run stryker.search.conf.mjs --dryRunOnly",
    "desktop:release:gate": "node scripts/desktop-release-gate.cjs",
    "desktop:release:gate:dry": "node scripts/desktop-release-gate.cjs --dry-run",
    "desktop:release:evidence": "node scripts/desktop-release-evidence.cjs",
    "desktop:release:evidence:summary": "node scripts/desktop-release-evidence-summary.cjs",
    "desktop:release:notes": "node scripts/desktop-release-notes.cjs",
    "desktop:release:version:check": "node scripts/desktop-version-check.cjs",
    "desktop:release:signing:report": "node scripts/desktop-signing-report.cjs",
    "wa-sqlite:final:gate": "node scripts/wa-sqlite-final-gate.cjs",
    "wa-sqlite:final:gate:unit": "node scripts/wa-sqlite-final-gate.cjs --skip-e2e",
    "wa-sqlite:final:gate:dry": "node scripts/wa-sqlite-final-gate.cjs --dry-run",
    "desktop:release:import": "node scripts/desktop-release-import-artifacts.cjs",
    "security:no-js-master-string": "node scripts/security-no-js-master-string.cjs",
    "security:session-gates": "node scripts/security-session-gates.cjs",
    "audit:checksums": "node scripts/generate-audit-package-checksums.cjs",
    "audit:checksums:verify": "node scripts/generate-audit-package-checksums.cjs --verify",
    "security:csp": "node scripts/security-csp-no-unsafe-inline.cjs",
    "security:release-hardening": "node scripts/security-release-hardening.cjs",
    "security:asset-integrity": "node scripts/generate-asset-integrity-manifest.cjs",
    "security:release-hardening:android": "node scripts/security-release-hardening.cjs --require-android-artifact",
    "test:fuzz": "vitest run src/lib/importer.fuzz.test.ts src/lib/encryption.fuzz.test.ts src/lib/attachments.fuzz.test.ts src/lib/share.fuzz.test.ts src/lib/otp.fuzz.test.ts src/lib/recoveryKey.fuzz.test.ts src/lib/fuzzySearch.fuzz.test.ts src/lib/backupValidation.fuzz.test.ts",
    "security:dependencies": "npm audit --audit-level=high",
    "rust:fmt:check": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "rust:test:native": "cargo test --manifest-path src-tauri/Cargo.toml write_vault_database_file",
    "release:readiness": "node scripts/release-readiness-summary.cjs",
    "release:readiness:final": "node scripts/release-readiness-summary.cjs --final --output release-local/RELEASE_READINESS_FINAL.md"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-tr": "^4.1.1",
    "argon2-browser": "^1.18.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.307",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "qs": "6.15.3",
    "adm-zip": "0.6.0",
    "shell-quote": "1.10.0"
  }
}
