# Recommended: copy this file to %USERPROFILE%\KalderaShieldKeys\android-signing.env
# (outside the repo and outside any cloud-synced folder such as OneDrive).
# Never commit the filled signing env file or the keystore.

KALDERASHIELD_ANDROID_KEYSTORE_PATH=C:\Users\<you>\KalderaShieldKeys\kalderashield-release.jks
KALDERASHIELD_ANDROID_KEY_ALIAS=kalderashield
KALDERASHIELD_ANDROID_KEYSTORE_PASSWORD=CHANGE_ME_KEYSTORE_PASSWORD
KALDERASHIELD_ANDROID_KEY_PASSWORD=CHANGE_ME_KEY_PASSWORD

# Use a JKS keystore, not PKCS12. PKCS12 cannot keep the key password
# different from the store password, so one leaked store password would
# also expose the private key. These two values must not be equal.
