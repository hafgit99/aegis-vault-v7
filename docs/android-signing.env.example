# Copy this file to .secrets/android-signing.env and fill it locally.
# Never commit the filled .secrets/android-signing.env file or the keystore.

AEGIS_ANDROID_KEYSTORE_PATH=C:\Users\<you>\AegisVaultKeys\aegis-vault-release.p12
AEGIS_ANDROID_KEY_ALIAS=aegis-vault
AEGIS_ANDROID_KEYSTORE_PASSWORD=CHANGE_ME_KEYSTORE_PASSWORD
AEGIS_ANDROID_KEY_PASSWORD=CHANGE_ME_KEY_PASSWORD
